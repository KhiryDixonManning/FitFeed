# Copy to .env for local development. NEVER commit real values.

# Anthropic API key used for outfit analysis.
ANTHROPIC_API_KEY=

# Firebase service account JSON, as a single line, for the Admin SDK.
# On Railway this is set as an environment variable; locally you may instead
# place a serviceAccountKey.json file next to app.py (it is gitignored).
GOOGLE_CREDENTIALS_JSON=

# Shared secret protecting POST /reanalyze-all (sent as the X-Admin-Key
# header). Leave unset to disable that endpoint entirely - it then 404s.
ADMIN_API_KEY=

# Storage bucket the analyser is allowed to download images from.
# Defaults to fitfeed-67ee8.firebasestorage.app when unset.
FIREBASE_STORAGE_BUCKET=

# Optional: DEBUG | INFO | WARNING | ERROR (default INFO)
LOG_LEVEL=

# --- background analysis worker (Procfile: worker) -------------------------
# The worker polls analysisJobs and runs the model outside the web request.
# Both have sensible defaults; set them only to tune throughput.

# Seconds between polls when the queue is empty (default 15).
WORKER_POLL_SECONDS=

# Jobs leased per pass (default 5). Each one is a paid model call, so raise
# this only alongside the Anthropic rate limit you actually have.
WORKER_BATCH_SIZE=
