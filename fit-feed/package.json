{
  "name": "fit-feed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:backend": "cd python-backend && ./venv/Scripts/python app.py",
    "dev:worker": "cd python-backend && ./venv/Scripts/python worker.py",
    "dev:frontend": "vite",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:worker\" \"npm run dev:frontend\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "deploy": "npm run build && firebase deploy",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore,storage --project fitfeed-rules-test \"vitest run --reporter=default --reporter=json --outputFile=vitest-report.json\"",
    "test:backend": "firebase emulators:exec --only firestore --project fitfeed-rules-test \"cd python-backend && python -m pytest -q\"",
    "typecheck": "tsc -b",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run check:secrets && npm run test:rules && npm run check:skips && npm run test:backend && npm run test:evaluate",
    "test:evaluate": "cd python-backend && python evaluate_recommendations.py",
    "check:skips": "node scripts/assert-no-skips.mjs vitest-report.json --label vitest",
    "check:secrets": "node scripts/check-hygiene.mjs"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^14.27.0",
    "globals": "^17.4.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^3.2.7"
  },
  "description": "This template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.",
  "main": "eslint.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.19"
  }
}
