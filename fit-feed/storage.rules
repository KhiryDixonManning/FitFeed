rules_version = '2';

// FitFeed Storage security rules.
//
// Every object lives under a uid-scoped prefix, and the uid in the path must
// match the verified caller - so a signed-in user cannot write into another
// user's folder. Uploads are restricted to images with a bounded size, which
// also caps what the backend analyser can be asked to download.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // request.resource is only populated on create/update, never on delete.
    function isBoundedImage(maxBytes) {
      return request.resource != null
          && request.resource.size > 0
          && request.resource.size <= maxBytes
          && request.resource.contentType is string
          && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|heic|heif)');
    }

    // Post images. Written by Upload.tsx after client-side compression to
    // JPEG, so the 10 MB ceiling is generous for legitimate uploads.
    match /posts/{uid}/{filename} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && isBoundedImage(10 * 1024 * 1024);
      allow delete: if isOwner(uid);
    }

    // Profile avatars. This path previously had no rule at all, so avatar
    // uploads were denied by the default-deny policy.
    match /avatars/{uid}/{filename} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && isBoundedImage(10 * 1024 * 1024);
      allow delete: if isOwner(uid);
    }
  }
}
